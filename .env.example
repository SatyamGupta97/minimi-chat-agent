# Required. Google Gemini API key (https://aistudio.google.com/apikey).
# Used for the chat model (with built-in Google Search grounding) and the
# small background model that extracts facts/titles after each turn.
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# CHAT_MODEL=gemini-3.8-flash          # needs Gemini 3+ (Search + function calling together); e.g. gemini-4-carbon for max quality
# CHAT_THINKING=medium                 # low | medium | high
# EXTRACT_MODEL=gemini-3.5-flash-lite
# PORT=3000
