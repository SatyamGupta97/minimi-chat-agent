# Paste ONE API key from any supported vendor. The vendor is detected from the key.
# OpenAI and Gemini work best: their embedding APIs add meaning-based memory search.
#   OpenAI              sk-…       https://platform.openai.com/api-keys
#   Gemini (Google)     AIza…      https://aistudio.google.com/apikey           (Search grounding needs billing enabled)
#   Claude (Anthropic)  sk-ant-…   https://console.anthropic.com/settings/keys  (enable web search in the Console)
#   Groq                gsk_…      https://console.groq.com/keys                (works on a free key)
LLM_API_KEY=

# Optional: a separate key used ONLY for embeddings (meaning-based memory search), so chat can stay on
# a vendor without an embedding API (Groq, Claude). Gemini (AIza… / AQ.…, free tier works) or OpenAI (sk-…).
EMBEDDING_API_KEY=

# Alternatively, vendor-specific variables also work:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Local model, no key (used by `npm run eval:local`; chat works too, but without web search):
# LLM_PROVIDER=ollama          # needs `ollama serve` and `ollama pull qwen3:4b`
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text  # optional meaning-based memory locally (ollama pull it; some versions need `ollama serve --embeddings`)

# Optional overrides (defaults depend on the vendor; an override for another vendor's model is ignored)
# LLM_PROVIDER=openai          # openai | gemini | anthropic | groq | ollama: force a vendor
# CHAT_MODEL=gpt-6.1-sol       # defaults: gpt-6.1-sol · gemini-3.8-flash · claude-opus-5-5 · openai/gpt-oss-120b
# EXTRACT_MODEL=               # background extraction; defaults: gpt-6-luna · gemini-3.5-flash-lite · claude-haiku-5-5 · openai/gpt-oss-20b
# MEMORY_SIMILARITY_MARGIN=    # meaning-search margin override (calibrated defaults in src/semantic.ts)
# CHAT_EFFORT=medium           # low | medium | high
# PORT=3000
