# One key is enough. Pick a provider by setting its key (Groq is used if both are set).

# Groq (works on a free key): openai/gpt-oss-120b with built-in browser search.
# https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini: gemini-3.8-flash with Google Search grounding.
# Search grounding needs a billing-enabled project. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults depend on the provider)
# LLM_PROVIDER=groq            # groq | gemini (otherwise picked from the key that is set)
# CHAT_MODEL=openai/gpt-oss-120b
# EXTRACT_MODEL=openai/gpt-oss-20b
# CHAT_EFFORT=low              # low | medium | high
# PORT=3000
