# Required. Used for the chat model, Anthropic's server-side web search tool,
# and the small background model that extracts facts/titles after each turn.
# Web search must be enabled for your org in the Anthropic Console.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# CHAT_MODEL=claude-opus-5-5
# CHAT_EFFORT=medium            # low | medium | high
# EXTRACT_MODEL=claude-haiku-5-5
# PORT=3000
